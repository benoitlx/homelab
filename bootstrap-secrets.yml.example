# Copy this file to .bootstrap-secrets.yml (gitignored) to bootstrap the
# infra before Vaultwarden exists. See docs/bootstrap.md for the full
# procedure. Delete .bootstrap-secrets.yml once every value below has been
# copied into Vaultwarden.

# Fill these in before Stage A — no infra needed to create them
caddy_ovh_application_key: ""
caddy_ovh_application_secret: ""
caddy_ovh_consumer_key: ""
headplane_cookie_secret: ""

# Fill this in after Stage A, once Headscale is up (before Stage B)
headscale_api_key: ""
