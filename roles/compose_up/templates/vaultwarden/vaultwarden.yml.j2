include:
  - ts-service.yml
{% if not item.public and (item.headscale_node | default(true)) and (item.tls | default(true)) %}
  - caddy-sidecar.yml
{% endif %}

services:
  vaultwarden:
    container_name: vaultwarden
    image: vaultwarden/server:latest
    pull_policy: always
    volumes:
      - /home/ansible/{{ item.file }}/config:/data
    restart: unless-stopped
    network_mode: service:ts-sidecar
    depends_on:
      - ts-sidecar
  
